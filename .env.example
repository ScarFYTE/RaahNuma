# AI Provider Selection
# Options: mock | claude | openai | gemini | ollama
# Default: mock (safe fallback, no API key needed)
VITE_AI_PROVIDER=mock

# Backend API (for future use)
VITE_API_BASE_URL=http://localhost:8000

# Provider API Keys (only needed when using that provider)
VITE_CLAUDE_API_KEY=sk-ant-...
VITE_CLAUDE_MODEL=claude-sonnet-4-6

VITE_OPENAI_API_KEY=sk-...
VITE_OPENAI_MODEL=gpt-4o

VITE_GEMINI_API_KEY=AIza...
VITE_GEMINI_MODEL=gemini-1.5-pro

VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_MODEL=llama3